// lab-app's rule set — design §5.6, read from `origin/bs` (the live branch; `main` is stale).
//
// lab-app is the production service of the three and the heaviest row-level user: `lab-app:site` alone is
// twelve `ap::ns` call sites. Each of those is mapped one by one in the design; this file is the
// other half of that mapping.
//
// **One correction to the design, verified against `origin/bs`.** §5.6 gave `daqs_ai_model` an
// `org` relation "if the column exists", flagged as the one place it could not confirm from the
// dump. It does not exist: `origin/bs:src/lab-app/entity/ai_models.rs` is
// `id, name, description, kind, version, revision, created_at, updated_at` and nothing else. The
// relation is therefore **omitted**, which is also the conservative outcome — the definition stays
// service-tier plus per-object grants, exactly today's behaviour, instead of gaining an
// organization branch that would widen access in production.

// Deliberately **no** `org->…` branch. Today a `lab-app:site` grant to `org:N` matches only a caller
// whose *own* organization is N (`who()` pushes exactly one organization), and there is no ancestor
// walk anywhere in lab-app's read path. Adding one would widen production. The subject
// `organization#member` reproduces the existing behaviour exactly.
//
// `blocked` exists here — and nowhere outside the board family — because
// `origin/bs:site/mod.rs:161,169` explicitly *preserves* `deny` rows when rewriting site
// permissions, in both the admin and the non-admin branch. The code contemplates operator-set
// denies on sites even though it never writes one, and dropping that capability from the heaviest
// row-level namespace in production is not a call to make silently.
//
// `SitePermissionLevel` maps to relations, which is how the wildcard-action problem disappears:
// the screen writes `action = {'*'}` for Edit (`origin/bs:entity/sites.rs:84`), and a migration that
// refused wildcards would refuse every lab-app database where somebody has pressed Edit. Here
// `Read`→`viewer` and `Edit`→`editor`, and the level round-trips exactly. The wire DTO
// (`{organizationId, userId, level}`) is unchanged, so lab-app's client needs no change.
definition daqs_site on sites.id int {
  relation manager: user = column(sites.manager_id -> user where sites.manager_id IS NOT NULL)

  relation viewer:  user | organization#member | role#member | apikey
  relation editor:  user | organization#member | role#member | apikey
  relation blocked: user | organization#member | role#member | apikey

  permission edit   = (manager | editor  | service:lab-app:site->operate_update) - blocked
  permission view   = (viewer  | edit    | service:lab-app:site->operate_read)   - blocked
  permission create = (editor  | manager | service:lab-app:site->operate_create) - blocked
  permission remove = (editor  | manager | service:lab-app:site->operate_delete) - blocked
  permission share  = manager | service:lab-app:site->operate_update
  permission grant  = share
}

definition daqs_structure on structures.id int {
  relation site: daqs_site = column(structures.site_id -> daqs_site)

  permission view   = site->view
  permission edit   = site->edit
  permission create = site->create
  permission remove = site->remove
}

// One join, exactly as `ap::ns("lab-app:site").join(Structures, SiteId)` pays for today.
definition daqs_photo on photos.id int {
  relation site: daqs_site = column(photos.structure_id -> daqs_site via structures.site_id)

  permission view   = site->view
  permission edit   = site->edit
  permission create = site->create
  permission remove = site->remove
}

// Two joins — `inspections → photos → structures → sites`, which is what
// `DaqsInspectionService::default_query_with` already assembles by hand.
definition daqs_inspection on inspections.id int {
  relation site: daqs_site = column(inspections.photo_id -> daqs_site
                                    via photos.structure_id, structures.site_id)

  permission view   = site->view
  permission edit   = site->edit
  permission create = site->create
  permission remove = site->remove
}

definition daqs_report on reports.id int {
  relation site: daqs_site = column(reports.site_id -> daqs_site)

  permission view   = site->view
  permission create = site->create
  permission remove = site->remove
}

definition daqs_ai_model on ai_models.id int {
  relation viewer:   user | organization#member | role#member | apikey
  relation operator: user | organization#member | role#member | apikey

  permission view   = viewer | operator | service:lab-app:ai_model->operate_read
  permission edit   = operator | service:lab-app:ai_model->operate_update
  permission remove = operator | service:lab-app:ai_model->operate_delete
}

// The route gate is `lab-app:downloadable_asset`; the row-level check uses `downloadable_asset`, with
// no prefix. Two namespaces for one resource, so a grant on one does nothing for the other — a
// defect found while enumerating. One definition unifies them and **both** service object ids are
// honoured, so no existing grant is lost.
definition daqs_downloadable_asset on downloadable_assets.id int {
  relation viewer:   user | organization#member | role#member | apikey
  relation operator: user | organization#member | role#member | apikey

  permission view   = viewer | operator
                    | service:downloadable_asset->operate_read
                    | service:lab-app:downloadable_asset->operate_read
  permission edit   = operator
                    | service:downloadable_asset->operate_update
                    | service:lab-app:downloadable_asset->operate_update
  permission remove = operator
                    | service:downloadable_asset->operate_delete
                    | service:lab-app:downloadable_asset->operate_delete
}

// lab-app's inquiry screens are boards: both services authorize through `ap::ns("board")` joined on
// `board_posts.board_id`, so the definitions walk to sumida's `board`.
definition daqs_inquiry on inquiries.post_id int {
  relation board: board = column(inquiries.post_id -> board via board_posts.board_id)

  permission view = board->view
  permission edit = board->edit
}

definition daqs_inquiry_rating on inquiry_ratings.post_id int {
  relation board: board = column(inquiry_ratings.post_id -> board via board_posts.board_id)

  permission view = board->view
  permission edit = board->edit
}

// ─── the namespace inventory ─────────────────────────────────────────────────────────────────
//
// Enumerated from lab-app/server on `origin/bs` (not checked out):
//   git grep -n 'service_ap!' origin/bs -- '*.rs'
//       → lab-app:ai_model(c,r,u,d) lab-app:downloadable_asset(c,r,u,d) lab-app:inspection(c,r,u,d)
//         lab-app:photo(c,r,u,d) lab-app:report(r,c,d) lab-app:site(c,r,u,d) lab-app:structure(c,r,u,d)
//   git grep -n 'ap::ns('     origin/bs -- '*.rs'
//       → lab-app:site × 12   (dashboard.rs:120,144,153; inspection/mod.rs:107,348;
//                           photo/mod.rs:96,241; report/mod.rs:536; site/mod.rs:574;
//                           site/tile_map.rs:33; structure/mod.rs:81,150)
//         board × 2        (inquiry/rating.rs:123, inquiry/status.rs:113)
//         organization     (site/mod.rs:442)
//         downloadable_asset (downloadable_asset/mod.rs:107)
//         lab-app:ai_model    (ai_model/mod.rs:113)
//
// `board` and `organization` are sumida's namespaces, already declared in `schema.zed`; lab-app
// consumes them, which is why a change to either reaches production.

namespace lab-app:ai_model            service = daqs_ai_model
namespace lab-app:downloadable_asset  service = daqs_downloadable_asset
namespace lab-app:inspection          service = daqs_inspection
namespace lab-app:photo               service = daqs_photo
namespace lab-app:report              service = daqs_report
namespace lab-app:site                service = daqs_site
namespace lab-app:structure           service = daqs_structure

// No route gate of its own — it exists because lab-app's row-level check uses the unprefixed name and
// existing grants have to keep matching.
namespace downloadable_asset       service = daqs_downloadable_asset
