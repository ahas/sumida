// site-app's rule set — design §5.7.
//
// `projects.owner_user_id` and `projects.organization_id` already exist
// (`migration/antares_acl_init.rs:15`), so nothing here is pending a schema change.

// `project_ap.rs` transcribed. Today:
//
//   ap::ns("site-app:project.row").who(session)
//     .join(projects::Entity, projects::Column::Slug)              // object = the slug
//     .object_in_subquery(organization_ancestors_subquery(projects.organization_id))
//
// so a row matches when `ap.object` equals the project's slug **or** any organization id in the
// project's organization's ancestor chain. "The object is an ancestor of the resource's
// organization" is exactly `manager^`/`editor^`/`viewer^` evaluated from the resource side — the
// `^` closure. `read` → `view_project`, `update` → `edit_project`, `owner` → `manage_project`,
// matching `OWNER_ACTIONS = ["read","update","owner"]` and `shares.rs::level_of`.
//
// The slug is the object id and may not be purely numeric — that is site-app's own rule, and it is
// what keeps a slug from colliding with an organization id in the one untyped `object` column. The
// tuple table has separate `resource_type` and `resource_id` columns, so the collision is no longer
// possible at all; the constraint is simply no longer load-bearing.
definition antares_project on projects.slug {
  relation org:        organization = column(projects.organization_id -> organization
                                             where projects.organization_id IS NOT NULL)
  relation owner_user: user         = column(projects.owner_user_id -> user
                                             where projects.owner_user_id IS NOT NULL)

  relation owner:  user | role#member | organization#member | apikey
  relation editor: user | role#member | organization#member | apikey
  relation viewer: user | role#member | organization#member | apikey

  permission own    = owner | owner_user | org->manage_project
                    | service:site-app:project->operate_delete
  permission edit   = own   | editor | org->edit_project
                    | service:site-app:project->operate_update
  permission view   = edit  | viewer | org->view_project
                    | service:site-app:project->operate_read
  permission create = service:site-app:project->can_create
  permission grant  = own
}

// `service/job/mod.rs:51`'s comment states that a job has no policy row of its own and is judged by
// **its project**. Saying that in the rule removes the `allowed_slugs` round trip for the joined
// case: the predicate lands on the joined query instead of materialising a slug set into Rust.
definition antares_job on jobs.id {
  relation project: antares_project = column(jobs.project_id -> antares_project via projects.slug
                                             where jobs.project_id IS NOT NULL)

  permission view = project->view
  permission edit = project->edit
}

// The remaining site-app namespaces have no row-level check anywhere and are service-tier only.
definition antares_artifact {
  permission view   = service:site-app:artifact->can_read
  permission edit   = service:site-app:artifact->can_update
  permission remove = service:site-app:artifact->can_delete
}

definition antares_cache {
  permission view   = service:site-app:cache->can_read
  permission remove = service:site-app:cache->can_delete
}

definition antares_chunk {
  permission view = service:site-app:chunk->can_read
  permission edit = service:site-app:chunk->can_update
}

definition antares_gcp {
  permission view = service:site-app:gcp->can_read
  permission edit = service:site-app:gcp->can_update
}

definition antares_image {
  permission view   = service:site-app:image->can_read
  permission create = service:site-app:image->can_create
  permission remove = service:site-app:image->can_delete
}

definition antares_survey {
  permission view = service:site-app:survey->can_read
  permission edit = service:site-app:survey->can_update
}

definition antares_system_settings {
  permission view = service:site-app:system-settings->can_read
  permission edit = service:site-app:system-settings->can_update
}

definition antares_workflow {
  permission view = service:site-app:workflow->can_read
}

// ─── the namespace inventory ─────────────────────────────────────────────────────────────────
//
// Enumerated from site-app/server/src:
//   grep -rn 'service_ap!' → site-app:artifact(r,d,u) site-app:cache(r,d) site-app:chunk(r,u)
//                            site-app:gcp(r,u) site-app:image(r,c,d) site-app:job(r,d,u)
//                            site-app:project(c,r,u,d) site-app:survey(r,u)
//                            site-app:system-settings(r,u) site-app:workflow(r)
//   grep -rn 'ap::ns('     → site-app:project.row (project_ap.rs:35) only
//
// **Orphans, deliberately absent:** `src/bin/initiator.rs:21,23,35` seeds `user_log`, `user_block`
// and `site-app:node`. Nothing anywhere gates on them, and `user_log`/`user_block` do not exist as
// sumida concepts either. They get no definition, and `rebac_backfill`'s `ORPHAN_NAMESPACES` drops
// their rows with a line each. Adding them here would manufacture a `service:` object for a typo.

namespace site-app:artifact        service = antares_artifact
namespace site-app:cache           service = antares_cache
namespace site-app:chunk           service = antares_chunk
namespace site-app:gcp             service = antares_gcp
namespace site-app:image           service = antares_image
namespace site-app:job             service = antares_job
namespace site-app:project         service = antares_project
namespace site-app:survey          service = antares_survey
namespace site-app:system-settings service = antares_system_settings
namespace site-app:workflow        service = antares_workflow

// The row-level namespace. It has no route gate of its own — site-app uses a *different* namespace
// for the gate on purpose, because sharing a namespace would make a project whose slug is
// "service" collide with the role gate seed.
namespace site-app:project.row = antares_project
