# E2E test environment. Copy to .env.e2e and fill in real values.
# Loaded by the e2e harness (e2e/src/bootstrap.rs).

# Admin connection used to CREATE the test database (points at the `postgres` db).
DATABASE_ADMIN_URL=postgres://user:password@localhost:5432/postgres

# The test database itself (must match [database].url in settings.e2e.toml).
DATABASE_URL=postgres://user:password@localhost:5432/sumida_test

# Path to the e2e settings file (absolute path recommended when running per-crate tests).
SUMIDA_SETTINGS=settings.e2e.toml
